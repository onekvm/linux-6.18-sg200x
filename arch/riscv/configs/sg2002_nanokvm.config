# NanoKVM Cube/PCIe 6.18 configuration overlay. Merged on top of the vendor
# 5.10 sg2002_licheervnano_sd .config after olddefconfig.
#
# Policy: keep shared CONFIG_* aligned with the NanoKVM 5.10 kernel
# (kernel-sophgo-onekvm-nanokvm.config). Do NOT feed that file to
# 6.18 olddefconfig — 5.10 has no VMAP_STACK line and 6.18 defaults
# it on, which breaks SG2002/CV181x vendor DMA paths that use
# virt_to_phys() on kernel objects.
# Intentional extras vs 5.10: see sg2002_nanokvm_kconfig.allow.
#
# Not ported: SOC_THEAD (ICE DTB), SUSPEND/PM_SLEEP, SET_FS,
# FB_CVITEK/CIF (no .c). Do not change AUD pinmux.
#
# Keep the dynamic-preemption kernel ABI separate from older 5.15 modules in
# persistent overlays; the image upgrade must refresh those modules together.
CONFIG_LOCALVERSION="-onekvm-preempt"
# CONFIG_LOCALVERSION_AUTO is not set
# Cube 256MiB is one contiguous bank; SPARSEMEM_EXTREME keeps a 16MiB
# mem_section** root table for 56-bit PA. Match 5.10 FLATMEM.
CONFIG_FLATMEM_MANUAL=y
# CONFIG_SPARSEMEM_MANUAL is not set
# SG2002/CV181x vendor drivers use DMA. Some paths (SPACC/VENC/GMAC)
# program engines with virt_to_phys() of kernel objects, including stack
# objects. VMAP_STACK has no direct linear physical mapping, so it can
# produce invalid DMA addresses. The vendor 5.10 kernel kept it disabled.
# CONFIG_VMAP_STACK is not set
# 5.10 Cube C906 TLB and MMF RT policy.
CONFIG_NO_SFENCE_VMA=y
CONFIG_SCHED_CVITEK=y
# Select full preemption by default, but expose none/voluntary/full through
# /sys/kernel/debug/sched/preempt for PCIe power and latency measurements.
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_DEBUG=y
# Same Kconfig name as 5.10. Probe maps pinmux MMIO only; no AUD rewrite.
CONFIG_CVITEK_PINCTRL_CV1835=y
# Cube has no HDMI audio; incomplete cvitek ASoC objects fail modpost.
# 5.10 nfs.cfg left these =m; keep them off on 6.18.
# CONFIG_SND_SOC_CV182XA_CV182XAADC is not set
# CONFIG_SND_SOC_CV182XA_CV182XADAC is not set
# CONFIG_SND_SOC_CV182XAADC is not set
# CONFIG_SND_SOC_CV182XADAC is not set
# CONFIG_SND_SOC_CV1835_USE_AUDIO_PLL is not set
# CONFIG_SND_CV1835_I2S is not set
# CONFIG_CV1835_I2S_SUBSYS is not set
# CONFIG_SOC_SIFIVE is not set
# CONFIG_SOC_VIRT is not set
# CONFIG_SOC_MICROCHIP_POLARFIRE is not set
# CONFIG_SMP is not set
# CONFIG_HOTPLUG_CPU is not set
# CONFIG_PCI is not set
# CONFIG_PCIEPORTBUS is not set
# CONFIG_STRICT_KERNEL_RWX is not set
# CONFIG_FRAME_POINTER is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
# C906 requires XTheadMae cache/share/buffer PTE attributes before the MMU is
# enabled.  Linux 6.18 supplies these through the early T-Head alternatives;
# without this erratum the kernel hangs immediately after "Starting kernel".
CONFIG_ERRATA_THEAD=y
CONFIG_ERRATA_THEAD_MAE=y
CONFIG_ERRATA_THEAD_CMO=y
# Linux 6.18 gates the CV1800 RTCSYS MFD behind the upstream Sophgo SoC
# selection.  The vendor 5.10 base configuration predates that symbol.
CONFIG_ARCH_SOPHGO=y
# SG2002's C906 implements the pre-ratification XTheadVector ISA, not the
# standard V 1.0 instructions emitted by Linux 6.18's vector probes.  The
# upstream Ghostwrite mitigation disables XTheadVector anyway, so keep vector
# support off instead of advertising an unusable and unsafe userspace ABI.
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_XTHEADVECTOR is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# CONFIG_HVC_RISCV_SBI is not set
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_CVITEK=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_CVITEK=y
CONFIG_SIFIVE_PLIC=y
CONFIG_CV181X_THERMAL=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_LLC=m
CONFIG_STP=m
CONFIG_ION=y
CONFIG_ION_SYSTEM_HEAP=y
CONFIG_ION_CARVEOUT_HEAP=y
CONFIG_ION_CMA_HEAP=y
CONFIG_ION_CVITEK=y
CONFIG_CRYPTO_DEV_CVITEK_SPACC=m
CONFIG_DWMAC_CVITEK=y
CONFIG_CVITEK_PHY=y
CONFIG_MMC_SDHCI_CVI=y
CONFIG_DMADEVICES=y
CONFIG_DMA_ENGINE=y
CONFIG_DW_DMAC_CVITEK=y
CONFIG_CV1835_SYSDMA_REMAP=y
CONFIG_EFUSE=y
CONFIG_CV181X_EFUSE=y
# CONFIG_CV180X_EFUSE is not set
CONFIG_DW_WATCHDOG=y
# CONFIG_ICE_WDT is not set
CONFIG_SOPHGO_CV1800_RTCSYS=y
CONFIG_RTC_DRV_CV1800=y
CONFIG_POWER_RESET_CVITEK=y
# CONFIG_CVI_WIFI_PIN is not set
# CONFIG_CVI_BT_PIN is not set
CONFIG_PACKET=y
CONFIG_NFS_V3=y
CONFIG_FHANDLE=y
CONFIG_CGROUP_FREEZER=y
# Do not EXTEND console=hvc0: U-Boot already has console=ttyS0, and hvc0
# (SBI putchar) is the same UART, so every printk would appear twice.
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_EXTEND is not set
# CONFIG_MODULE_SIG is not set
# CONFIG_SYSTEM_TRUSTED_KEYRING is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
# Report the C906 clock for lscpu. Do not enable CPUFREQ_DT: generic
# clk_set_rate() on clk_c906_0 is not XTAL-bypass safe.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPUFREQ_CVITEK=y
# CONFIG_CPUFREQ_DT is not set
